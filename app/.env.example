# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# Local dev:  VITE_API_URL=http://localhost:8788
# Production: VITE_API_URL=/api   (relative — same origin as Cloudflare Pages)
#
# These are baked into the client bundle at build time. The Supabase anon key
# is designed to be public — RLS protects the data, not the key.
#
# In production, set these in app/.env.local (gitignored) before running
# `npm run build`. The Cloudflare Pages worker reads separate server-side
# secrets (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_KEY,
# SUPABASE_JWT_SECRET) that are NOT exposed to the browser.
VITE_API_URL=/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Cloudflare Pages Functions env vars ────────────────────────────────────
# Set these in: Cloudflare Dashboard → Pages → clipai → Settings → Environment variables
# Then retry the latest deployment so they take effect.

# ── AI / LLM (provider priority: SiliconFlow → Mistral → Groq) ─────────────
# Set ONE key. If multiple are set, the higher-priority provider wins.
# All three expose OpenAI-compatible /v1/chat/completions endpoints.

# SiliconFlow (PRIMARY) — get a key at: https://cloud.siliconflow.com/account/ak
# International endpoint (api.siliconflow.com, NOT .cn).
# Most models are reasoning models: they emit reasoning_content before content.
# Default model: 'Qwen/Qwen3-32B' (good JSON, balanced)
SILICONFLOW_API_KEY=

# Mistral (fallback 1) — https://console.mistral.ai/api-keys
# Default model: 'mistral-small-latest'
MISTRAL_API_KEY=

# Groq (fallback 2) — https://console.groq.com/keys
# Default model: 'llama-3.3-70b-versatile'
GROQ_API_KEY=

# Optional: override the default model. Provider-specific good picks:
#   SiliconFlow: 'deepseek-ai/DeepSeek-V4-Pro' | 'zai-org/GLM-5.2' | 'moonshotai/Kimi-K2.7'
#   Mistral:     'open-mistral-nemo' | 'mistral-large-latest'
#   Groq:        'llama-3.1-8b-instant'
LLM_MODEL=

# Gemini (used for clip analysis — separate from LLM synthesis above)
GEMINI_API_KEY=

# ── Trends ──────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
SERPER_API_KEY=
REDDIT_USER_AGENT=clipai-trend-radar/2.0

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# ── Paystack ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
