# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# Local dev:  VITE_API_URL=http://localhost:8788
# Production: VITE_API_URL=/api   (relative — same origin as Cloudflare Pages)
VITE_API_URL=/api

# ─── Cloudflare Pages Functions env vars ────────────────────────────────────
# Set these in: Cloudflare Dashboard → Pages → clipai → Settings → Environment variables
# Then retry the latest deployment so they take effect.

# ── AI / LLM (pick ONE — Mistral is primary, Groq is fallback) ──────────────
# Get a Mistral key at: https://console.mistral.ai/api-keys
# Free tier: ~$0 / mo with rate limits; paid: ~$0.20/1M input, ~$0.60/1M output
MISTRAL_API_KEY=

# Get a Groq key at: https://console.groq.com/keys
# Free tier: generous rate limits, fast inference
GROQ_API_KEY=

# Optional: override the default model. Defaults:
#   Mistral → 'mistral-small-latest'
#   Groq    → 'llama-3.3-70b-versatile'
# Other options:
#   'open-mistral-nemo'      (Mistral, 128k context, great for long inputs)
#   'mistral-large-latest'   (Mistral flagship, highest quality)
#   'llama-3.1-8b-instant'   (Groq, fastest)
LLM_MODEL=

# Gemini (used for clip analysis — separate from LLM synthesis above)
GEMINI_API_KEY=

# ── Trends ──────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=
SERPAPI_KEY=
REDDIT_USER_AGENT=clipai-trend-radar/2.0

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# ── Paystack ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
