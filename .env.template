# ── AI Services ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
JSON2VIDEO_API_KEY=your_json2video_api_key_here

# ── Cloudflare R2 (primary storage) ──────────────────────────────────────────
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET=clipai
R2_PUBLIC_URL=https://your-r2-public-domain.com

# ── Backblaze B2 (fallback storage) ──────────────────────────────────────────
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=clipai
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key

# ── Supabase (auth + database) ───────────────────────────────────────────────
# Dashboard → Project Settings → API
#   - URL:                Project URL
#   - anon key:           "anon public" key (safe for frontend)
#   - service_role key:   "service_role" key (server-only, bypasses RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ── Redis (render job queue) ─────────────────────────────────────────────────
# Railway → New → Redis. Leave blank to fall back to in-memory (dev only).
REDIS_URL=redis://default:password@host:port

# ── Worker auth ──────────────────────────────────────────────────────────────
# Frontend sends this as `Authorization: Bearer <token>` after Supabase login.
# Generate with: openssl rand -hex 32
WORKER_SECRET=change_me_to_a_long_random_string

# ── Railway ───────────────────────────────────────────────────────────────────
PORT=8000

# ── Frontend (Vite — put in app/.env.local or app/.env.production) ───────────
# VITE_API_URL=https://your-railway-app.railway.app
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── Trend Radar APIs (v4.3 — keyless-first model) ────────────────────────────
# 5 platforms total. Only SerpAPI needs a paid key. Reddit + Google Trends are KEYLESS.

# YouTube Data API v3 — free, 10k quota units/day (100/search).
# Get key: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Reddit — NO API KEY, NO OAuth, NO policy acceptance.
# Uses public .json endpoints (https://www.reddit.com/r/{sub}/top.json).
# Just set a descriptive User-Agent per Reddit's bot policy:
REDDIT_USER_AGENT=clipai-trend-radar/2.0 by u_your_reddit_username

# Google Trends — NO KEY (uses pytrends library).

# SerpAPI — OPTIONAL. Only used for TikTok + Twitter/X (no free API exists).
# Without it, TrendRadar still works on YouTube + Reddit + Google Trends.
# $75/mo for ~5k calls across both platforms.
SERPAPI_KEY=your_serpapi_key_here

# Twitch — DROPPED (Helix API requires 2FA-locked dev console).
# To re-enable later: set TWITCH_CLIENT_ID + TWITCH_CLIENT_SECRET and
# restore _twitch_* helpers from git history (commit 5b89523).
